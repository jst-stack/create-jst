{
  "name": "create-jst",
  "version": "0.4.17",
  "description": "Create a web application from the JST template.",
  "type": "module",
  "packageManager": "npm@11.6.2",
  "bin": {
    "create-jst": "src/cli.mjs",
    "jst": "src/jst.mjs"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "benchmark": "node scripts/run-benchmarks.mjs",
    "benchmark:update": "node scripts/run-benchmarks.mjs --write-baseline",
    "test": "node --test test/integration.test.mjs test/migration.test.mjs test/options.test.mjs test/projectInitializer.test.mjs",
    "test:generated": "node --test test/generatedProject.test.mjs",
    "check": "npm run lint && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jst-stack/create-jst.git"
  },
  "bugs": {
    "url": "https://github.com/jst-stack/create-jst/issues"
  },
  "homepage": "https://github.com/jst-stack/jst#readme",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@reatom/core": "^1001.3.0",
    "@reatom/react": "^1001.0.1",
    "degit": "^3.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0"
  }
}
